{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": false,
  "terminal.integrated.profiles.linux": {
    "zsh (spotter venv)": {
      "path": "zsh",
      "args": [
        "-i",
        "-c",
        "source \"${workspaceFolder}/.venv/bin/activate\" && exec zsh -i"
      ]
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh (spotter venv)"
}
